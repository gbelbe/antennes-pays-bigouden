# ── Mesures ────────────────────────────────────────────────────

dos:m-hauteur-sommitale a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Hauteur sommitale du pylône : 32,65 m (30 m annoncés)"@fr ;
    ant:valeur 32.65 ; ant:unite "m" ; ant:methode "Lecture de la cote « Ht sommitale » sur l'élévation, p. 13 du dossier d'information de l'opérateur. Altitude 58,25 m NGF pour un terrain à 26 m." ;
    ant:porteSurObjet dos:projet-pylone ; prov:wasDerivedFrom src:dim-bouygues ; prov:wasGeneratedBy src:act-lecture-pdf ;
    prov:wasAttributedTo src:claude ; prov:generatedAtTime "2026-10-15T00:00:00"^^xsd:dateTime ;
    note:note "Chiffre de l'opérateur. L'avis de dépôt et le panneau disent 30 m." .

dos:m-massif-beton a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Massif béton du pylône : 29,16 m²"@fr ;
    ant:valeur 29.16 ; ant:unite "m²" ; ant:methode "5,40 m × 5,40 m, cotes de l'élévation et du plan, p. 12-13 du dossier d'information." ;
    ant:porteSurObjet dos:projet-pylone ; prov:wasDerivedFrom src:dim-bouygues ; prov:wasGeneratedBy src:act-lecture-pdf ;
    prov:wasAttributedTo src:claude ; prov:generatedAtTime "2026-10-15T00:00:00"^^xsd:dateTime ;
    note:note "À rapprocher du seuil de 20 m² (R. 421-9) ; la prise en compte d'une fondation est à vérifier." .

dos:m-dalle-technique a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Dalle des équipements techniques au sol : 2 m²"@fr ;
    ant:valeur 2 ; ant:unite "m²" ; ant:methode "2,00 m × 1,00 m, cotes du plan et de l'élévation, p. 12-13 du dossier d'information." ;
    ant:porteSurObjet dos:projet-pylone ; prov:wasDerivedFrom src:dim-bouygues ; prov:wasGeneratedBy src:act-lecture-pdf ;
    prov:wasAttributedTo src:claude ; prov:generatedAtTime "2026-10-15T00:00:00"^^xsd:dateTime .

dos:m-position-operateur a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Position donnée par l'opérateur : dans la parcelle YX 26, à 4 m du bord"@fr ;
    ant:valeur 4.4 ; ant:unite "m" ; ant:methode "Coordonnées Lambert II étendu du dossier d'information (X 106 077, Y 2 340 312, Z 26 m NGF) converties en WGS84 par un calcul maison (formules IGN, translation NTF-WGS84 approchée, quelques mètres d'incertitude), puis distance au bord du polygone de la parcelle YX 26. Point à 64 m du centre de la parcelle utilisé pour la carte, à l'angle côté route." ;
    ant:porteSurObjet dos:parcelle-yx26 ; prov:wasDerivedFrom src:dim-bouygues, src:apicarto-cadastre ; prov:wasGeneratedBy src:act-lecture-pdf ;
    prov:wasAttributedTo src:claude ; prov:generatedAtTime "2026-10-15T00:00:00"^^xsd:dateTime ;
    note:note "Le plan cadastral du dossier (p. 9) place aussi le pylône à l'angle de la parcelle 26, au bord du chemin. La carte conserve le centre de la parcelle ; un pylône à 4 m du bord rapproche son pied des habitations voisines par rapport aux distances mesurées depuis le bord de parcelle (23 m pour la première maison)." .

dos:m-dist-maison1 a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance parcelle → habitation 1 : 23 m"@fr ;
    ant:valeur 23 ; ant:unite "m" ; ant:methode "IGN BD TOPO, distance au bord de parcelle" ;
    ant:porteSurObjet dos:parcelle-yx26 ; ant:parRapportA dos:maison-1 .

dos:m-dist-maison2 a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance parcelle → habitation 2 : 32 m"@fr ;
    ant:valeur 32 ; ant:unite "m" ; ant:methode "IGN BD TOPO" ;
    ant:porteSurObjet dos:parcelle-yx26 ; ant:parRapportA dos:maison-2 .

dos:m-dist-zone-humide a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance parcelle → zone humide : 8 m"@fr ;
    ant:valeur 8 ; ant:unite "m" ; ant:methode "APIcarto GPU, prescriptions surfaciques" ;
    ant:porteSurObjet dos:parcelle-yx26 ; ant:parRapportA dos:zone-humide-voisine .

dos:m-dist-ebc a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance parcelle → EBC : 34 m"@fr ;
    ant:valeur 34 ; ant:unite "m" ; ant:methode "APIcarto GPU" ;
    ant:porteSurObjet dos:parcelle-yx26 ; ant:parRapportA dos:ebc-voisin .

dos:m-dist-abords a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance parcelle → périmètre des abords : 163 m"@fr ;
    ant:valeur 163 ; ant:unite "m" ; ant:methode "APIcarto GPU, assiette SUP AC1" ;
    ant:porteSurObjet dos:parcelle-yx26 ; ant:parRapportA dos:abords-trevilit ;
    note:note "Mesure défavorable, à connaître avant de plaider le patrimoine : la parcelle est **hors** périmètre." .

dos:m-dist-manoir a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance manoir → bord de parcelle : 648 m"@fr ;
    ant:valeur 648 ; ant:unite "m" ; ant:methode "calcul géodésique sur géométries IGN" ;
    ant:porteSurObjet dos:mh-trevilit ; ant:parRapportA dos:parcelle-yx26 .

dos:m-covisibilite a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Covisibilité manoir ↔ parcelle : directe"@fr ;
    ant:valeur 1 ; ant:unite "booléen" ;
    ant:methode "Profil IGN RGE ALTI, 31 points : parcelle à 25,8 m NGF, manoir à 21,6 m NGF, aucun obstacle de relief. Modèle de terrain nu : la végétation n'est pas prise en compte." ;
    ant:porteSurObjet dos:mh-trevilit ; ant:parRapportA dos:parcelle-yx26 .

# ═══════════════════════════════════════════════════════════════
#  PROJET
# ═══════════════════════════════════════════════════════════════

dos:projet-pylone a owl:NamedIndividual, ant:ProjetAntenne ;
    rdfs:label "Relais radioélectrique de Kersalous"@fr ;
    ant:implanteSur dos:parcelle-yx26 ;
    geo:asWKT "POINT(-4.274491 47.874985)"^^geo:wktLiteral ;
    ant:comprendOuvrage dos:ouvrage-pylone, dos:ouvrage-zone-technique, dos:ouvrage-cloture, dos:ouvrage-massif-beton .

dos:ouvrage-pylone a owl:NamedIndividual, ant:Ouvrage ;
    rdfs:label "Pylône treillis 30 m"@fr ; ant:hauteur 30 ;
    note:note "Hauteurs lues sur l'élévation du dossier d'information (p. 13) : pylône 30,25 m ; hauteur sommitale **32,65 m** ; antennes 4G/5G à 28,60 m ; faisceau hertzien à 30,50 m. L'avis de dépôt et le panneau annoncent 30 m : l'écart de 2,65 m tient aux équipements en tête. Altitude du terrain : 26 m NGF." .

dos:ouvrage-zone-technique a owl:NamedIndividual, ant:Ouvrage ;
    rdfs:label "Zone technique sur dalle béton"@fr ; ant:empriseAuSol 2 ;
    note:note "Emprise laissée vide sur l'avis de dépôt. **Le dossier d'information de l'opérateur (p. 12-13) donne une dalle de 2,00 m × 1,00 m, soit 2 m²** pour les équipements au sol (« 15 équipements techniques » repérés en tête de pylône). Chiffre de l'opérateur, non confirmé par le plan de masse de la DP : le dossier de la DP (DP1 à DP8) reste la pièce à obtenir. La clôture n'est pas citée dans le dossier d'information." .

dos:ouvrage-massif-beton a owl:NamedIndividual, ant:Ouvrage ;
    rdfs:label "Massif béton du pylône 5,40 m × 5,40 m"@fr ; ant:empriseAuSol 29.16 ;
    prov:wasDerivedFrom src:dim-bouygues ;
    note:note "Fondation du pylône : 5,40 × 5,40 = **29,16 m²**, soit plus que le seuil de 20 m². Qu'elle compte ou non comme emprise au sol dépend de la lecture du seuil (fondation enterrée ou non, avis du Conseil d'État du 21 mars 2024 à lire : dos:act-lire-avis-ce-2024). Non repris dans la liste des ouvrages de la DP : à vérifier sur le plan de masse." .

dos:ouvrage-cloture a owl:NamedIndividual, ant:Ouvrage ;
    rdfs:label "Clôture grillagée RAL 6005, 2 m"@fr ; ant:hauteur 2 .

