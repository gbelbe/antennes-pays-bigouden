dos:phoenix-france a owl:NamedIndividual, ant:Entreprise ;
    rdfs:label "Phoenix France Infrastructures"@fr ; ant:siren "853958650" ;
    ant:aRole dos:role-demandeur ; ant:representantLegal dos:personne-culver ;
    ant:filialeDe dos:phoenix-tower-international ;
