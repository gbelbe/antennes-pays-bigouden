# ═══════════════════════════════════════════════════════════════
#  RÉSEAUX MOBILES EXISTANTS (ANFR) — octobre 2026
# ═══════════════════════════════════════════════════════════════

src:anfr a owl:NamedIndividual, prov:Organization ;
    rdfs:label "ANFR — Agence nationale des fréquences"@fr .

src:anfr-observatoire a owl:NamedIndividual, src:JeuDeDonnees ;
    prov:generatedAtTime "2026-10-13"^^xsd:date ;
    prov:wasAttributedTo src:anfr ;
    src:dateDonnees "fichier observatoireod_20261001.csv, champ date_maj 2026-10-01" ;
    rdfs:label "ANFR — Observatoire des réseaux mobiles 2G/3G/4G/5G"@fr ;
    dcat:accessURL "https://data.anfr.fr/d4c/api/records/2.0/search/?resource_id=88ef0887-6b0f-4d3f-8545-6d64c8f597da"^^xsd:anyURI ;
    dcterms:publisher src:anfr ; dcterms:license "Licence Ouverte 2.0" ;
    src:niveauDePreuve src:primaire ;
    note:note "Une ligne par système radio (ex. LTE 800) d'une station d'opérateur sur un support. Hors périmètre : installations de moins de 5 W, Défense, Intérieur, aviation civile. Coordonnées arrondies à la seconde d'arc (≈ 30 m). La nature du support (NAT_ID) n'a pas pu être décodée : table de correspondance non retrouvée dans l'API." .

src:act-anfr a owl:NamedIndividual, src:Interrogation ;
    rdfs:label "Interrogation de l'observatoire ANFR"@fr ;
    prov:used src:anfr-observatoire ; prov:wasAssociatedWith src:claude ;
    prov:endedAtTime "2026-10-13T18:40:00"^^xsd:dateTime ;
    src:requete "q=029 (texte intégral, 10 659 lignes), puis filtre local : supports à moins de 10 km du centre de la parcelle YX 26 (haversine) — 32 supports, 78 stations." ;
    note:note "L'API ne filtre pas sur la colonne département ; le filtre repose sur la recherche plein texte « 029 ». Vérifié : les 10 659 lignes ont sta_nm_dpt = 029. **Correction (2026-10-13)** : la première extraction paginait sans tri et perdait des lignes (30 supports, 68 stations au lieu de 32 et 78 ; un support Free à 2,6 km manquait). L'extraction a été refaite avec `sort=_id` : 10 659 identifiants distincts, sans doublon. Le total n'a pas été comparé à une autre source." .

src:act-distances-anfr a owl:NamedIndividual, src:Calcul ;
    rdfs:label "Distance des supports à la parcelle"@fr ;
    prov:used src:anfr-observatoire, src:apicarto-cadastre ; prov:wasAssociatedWith src:claude ;
    prov:endedAtTime "2026-10-13T18:45:00"^^xsd:dateTime ;
    note:note "Distance du point ANFR au bord du polygone de la parcelle (projection plane locale, 0 si le point est dans la parcelle), arrondie à 10 m. Précision limitée par l'arrondi des coordonnées ANFR (≈ 30 m)." .

src:act-affirmation-operateur a owl:NamedIndividual, prov:Activity ;
    rdfs:label "Affirmation de l'opérateur du site projeté"@fr ;
    prov:wasAssociatedWith src:utilisateur ;
    prov:endedAtTime "2026-10-13T19:30:00"^^xsd:dateTime ;
    note:note "Fait énoncé par l'utilisateur : l'antenne projetée à Kersalous est celle de Bouygues Telecom. **Confirmé le 2026-10-15 par le dossier d'information de Bouygues Telecom (src:dim-bouygues) : « Ce site est exploité par Bouygues Télécom », site T18D84.** L'assertion n'est plus la seule source." .

src:act-constat-panneau a owl:NamedIndividual, prov:Activity ;
    rdfs:label "Constat de la pose du panneau sur le terrain"@fr ;
    prov:wasAssociatedWith src:utilisateur ;
    prov:endedAtTime "2026-10-15T00:00:00"^^xsd:dateTime ;
    note:note "Fait énoncé par l'utilisateur le 15 octobre 2026 : le panneau a été posé la veille (14 octobre 2026). Source déclarative (niveau « assertion »). Une photo du panneau, reçue le 14 octobre à 19 h 11, est depuis au dossier (src:photo-panneau). Elle montre un autocollant de constat de commissaire de justice dont la date est inconnue : le 14 octobre est donc la date d'observation, pas nécessairement celle de pose." .

dos:ev-affichage-terrain prov:wasGeneratedBy src:act-constat-panneau .

# ═══════════════════════════════════════════════════════════════
#  COUVERTURE MOBILE THÉORIQUE (ARCEP) — T2 2026
# ═══════════════════════════════════════════════════════════════

src:arcep a owl:NamedIndividual, prov:Organization ;
    rdfs:label "ARCEP — Autorité de régulation des communications électroniques"@fr .

src:arcep-couv-bouy-4g a owl:NamedIndividual, src:JeuDeDonnees ;
    prov:generatedAtTime "2026-10-13"^^xsd:date ;
    prov:wasAttributedTo src:arcep ;
    src:dateDonnees "couverture simulée au 2026-06-30, publiée par l'ARCEP le 2026-09-24 (millésime 2026_T2)" ;
    rdfs:label "ARCEP — couverture 4G data Bouygues Telecom, métropole, 2026 T2"@fr ;
    dcat:accessURL "https://data.arcep.fr/mobile/couvertures_theoriques/2026_T2/Metropole/00_Metropole/2026_T2_couv_Metropole_BOUY_4G_data.gpkg.7z"^^xsd:anyURI ;
    dcterms:publisher src:arcep ; dcterms:license "Licence Ouverte (Etalab)" ;
    src:niveauDePreuve src:primaire ;
    note:note "GeoPackage national (RGF93 / Lambert-93), une géométrie par département et par niveau (TBC, BC, CL) ; 323 195 833 octets compressés, SHA-256 de l'archive : bbf8b7b3329029cba0ef4998e7ee1fe38654b235482c6e7533ce60335d798a76. Couverture **simulée par l'opérateur**, vérifiée par échantillonnage par l'ARCEP, extérieure uniquement. Licence : Licence Ouverte (Etalab), identifiant « fr-lo » dans l'API data.gouv.fr (jeu « Mon Réseau Mobile », producteur ARCEP, lu le 2026-10-14) ; republication permise avec mention de la source (ARCEP). Les couvertures Orange, SFR, Free, la 3G et la 5G ne sont pas chargées (5G absente de la publication ouverte)." .

src:act-telechargement-arcep a owl:NamedIndividual, src:Interrogation ;
    rdfs:label "Téléchargement du fichier ARCEP Bouygues 4G"@fr ;
    prov:used src:arcep-couv-bouy-4g ; prov:wasAssociatedWith src:claude, src:utilisateur ;
    prov:endedAtTime "2026-10-13T22:01:00"^^xsd:dateTime ;
    src:requete "curl simple (GET), sans en-tête ni donnée d'identification ajoutée, repris sur un fichier partiel (-C -). Taille finale égale au Content-Length annoncé." ;
    note:note "Téléchargement demandé par l'utilisateur ; deux premières tentatives interrompues, 256 Mo partiels écartés." .

src:act-arcep-decoupe a owl:NamedIndividual, src:Calcul ;
    rdfs:label "Découpe et simplification des zones de couverture"@fr ;
    prov:used src:arcep-couv-bouy-4g ; prov:wasAssociatedWith src:claude ;
    prov:endedAtTime "2026-10-13T22:10:00"^^xsd:dateTime ;
    note:note "Département 29 ; intersection avec un disque de 10 km autour du site projeté (Lambert-93) ; simplification de Douglas-Peucker à 30 m avec préservation de la topologie (environ 1,5 % de la surface en écart) ; reprojection en WGS84, 5 décimales. Outils : shapely 2.2.0, pyproj. La simplification ne sert qu'à l'affichage." .

src:act-arcep-mesures a owl:NamedIndividual, src:Calcul ;
    rdfs:label "Mesures de redondance de couverture au site projeté"@fr ;
    prov:used src:arcep-couv-bouy-4g, src:geo-api-communes, src:act-arcep-decoupe ; prov:wasAssociatedWith src:claude ;
    prov:endedAtTime "2026-10-13T22:15:00"^^xsd:dateTime ;
    note:note "Calculées sur les polygones complets, non simplifiés. Le masque terrestre est l'union des contours communaux du Finistère (geo.api.gouv.fr) : sans lui, la mer comptait comme « non couverte ». Marge d'erreur : contours communaux et simulation ARCEP n'ont pas la même résolution ; une lacune de moins d'un km² en bord de côte peut être un artefact." .

# ── Comparaison nationale de la couverture (2026-10-14) ──
src:geo-api-communes-france a owl:NamedIndividual, src:JeuDeDonnees ;
    prov:generatedAtTime "2026-10-14"^^xsd:date ;
    rdfs:label "API Découpage administratif — toutes les communes de France (nom, population, surface, centre)"@fr ;
    dcat:accessURL "https://geo.api.gouv.fr/communes?fields=nom,code,codeDepartement,population,surface,centre&format=json&geometry=centre"^^xsd:anyURI ;
    dcterms:publisher src:etalab ; dcterms:license "Licence Ouverte 2.0" ;
    prov:wasAttributedTo src:etalab ;
    note:note "34 969 communes téléchargées, dont 34 746 métropolitaines retenues. La population est celle publiée par l'INSEE via l'API (recensement légal) ; la surface est en hectares. SHA-256 du fichier téléchargé : 0b079c8334303a6117b8b9a3476a27a0ecaf96ca9ac930f61611f37cbb65094d." .

src:act-comparaison-rurale a owl:NamedIndividual, src:Calcul ;
    rdfs:label "Comparaison de la couverture 4G Bouygues Telecom du secteur avec les autres zones rurales"@fr ;
    prov:used src:arcep-couv-bouy-4g, src:geo-api-communes-france ; prov:wasAssociatedWith src:claude ;
    prov:endedAtTime "2026-10-14T00:00:00"^^xsd:dateTime ;
    note:note "Pour chaque commune métropolitaine, test du centre dans les polygones ARCEP du département (très bonne, bonne, limitée), puis agrégation par ensemble. Seuils « rural » fixés par l'auteur (< 40 hab/km², < 2 500 habitants) : un autre seuil déplace légèrement les pourcentages. Le centre d'une commune ne dit rien des hameaux ni des routes. Un seul opérateur et une seule génération (4G Bouygues)." .

# ── Reportage « 5G : les antennes de la colère » (2026-10-14) ──
src:page-resumee a owl:NamedIndividual, src:NiveauDePreuve ;
    rdfs:label "Page web lue par résumé automatique, contenu audiovisuel non visionné"@fr ;
    note:note "Le texte de la page (titre, chapeau, crédits) a été récupéré et résumé par un outil automatique. **La vidéo n'a pas été visionnée** : seuls les faits annoncés par la page sont repris, au conditionnel, comme propos du reportage et non comme faits établis. À compléter par le visionnage avant toute citation." .

src:france-televisions a owl:NamedIndividual, prov:Organization ;
    rdfs:label "France Télévisions"@fr .
src:franceinfo a owl:NamedIndividual, prov:Organization ;
    rdfs:label "franceinfo"@fr ; foaf:homepage "https://www.franceinfo.fr"^^xsd:anyURI .

src:franceinfo-envoye-special a owl:NamedIndividual, src:DocumentSource ;
    prov:generatedAtTime "2026-10-14"^^xsd:date ;
    prov:wasAttributedTo src:france-televisions ;
    rdfs:label "franceinfo — « 5G : les antennes de la colère », Envoyé spécial (France 2, 28 mai 2026)"@fr ;
    dcat:accessURL "https://www.franceinfo.fr/replay-magazine/france-2/envoye-special/video-5g-les-antennes-de-la-colere_8026961.html"^^xsd:anyURI ;
    dcterms:publisher src:franceinfo ; dcterms:created "2026-05-28"^^xsd:date ;
    src:niveauDePreuve src:page-resumee ;
    note:note "Page de replay, 36 min 21 s, diffusée le 28 mai 2026 dans Envoyé spécial (présentation Elise Lucet). Reportage de Coline Hervé, Ulysse Cailloux, Yonathan Von Der Voort, Marc Woudenberg, Manon Le Goff, Jérémy Luc et Rémy Vincent, produit par Spica Presse. Le chapeau cite environ 72 000 pylônes en France, soit à peu près le double d'il y a quinze ans, et interroge les normes, les effets sanitaires, la rivalité commerciale entre opérateurs et l'impuissance supposée des pouvoirs publics. Cas cités par la page : Saintigny (Perche, projet de mât de 212 m à moins d'1 km d'un mât existant assurant le même service), Heiligenberg (Alsace, zone blanche après démontage d'une antenne) et Lormont (Gironde, antennes de 30 m à environ 50 m d'un jardin). Le chapeau évoque des soupçons d'entente entre opérateurs et gestionnaires de sites, sans les nommer." .

src:act-lecture-franceinfo a owl:NamedIndividual, src:Interrogation ;
    rdfs:label "Lecture de la page franceinfo du reportage"@fr ;
    prov:used src:franceinfo-envoye-special ; prov:wasAssociatedWith src:claude, src:utilisateur ;
    prov:endedAtTime "2026-10-14T21:00:00"^^xsd:dateTime ;
    src:requete "Récupération de la page par GET et résumé par un modèle rapide ; navigation et encarts du site écartés." ;
    note:note "Lien fourni par l'utilisateur. La vidéo elle-même n'a pas été regardée ni transcrite." .

